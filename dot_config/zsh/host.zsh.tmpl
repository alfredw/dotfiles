# Per-machine shell config. Sourced from .zshrc after the shared modules, so it
# can override them. Keyed on hostname by chezmoi — see dot_config/zsh/host.zsh.tmpl.

{{ if eq .chezmoi.hostname "nerv" -}}
# ── nerv ─────────────────────────────────────────────────────────────────────
# mise owns node, bun and java (reading .nvmrc and .java-version). fnm and jenv
# are gone. pyenv stays for now — not for interpreters, but because two work
# projects rely on pyenv-virtualenv auto-activation, which mise has no
# equivalent for: their .python-version files name an *env* rather than a
# version ("llm-services", and one pointing into a conda env).
#
# fnm is deliberately not initialised: it and `mise activate` both hook cd to
# rewrite node's PATH, so running both makes the version you get depend on load
# order.

# pyenv — the 7 named virtualenvs and their auto-activation
export PYENV_ROOT="$HOME/.pyenv"
[[ -d $PYENV_ROOT/bin ]] && path=("$PYENV_ROOT/bin" $path)
if (( $+commands[pyenv] )); then
  eval "$(pyenv init -)"
  eval "$(pyenv virtualenv-init -)"
fi

# jenv is gone: mise owns java now (and exports JAVA_HOME, which jenv needed a
# plugin for). The brew JDKs are left installed but unmanaged; nothing depends
# on them, so they can be removed whenever.

# pnpm — the PAI monorepo depends on it
export PNPM_HOME="$HOME/Library/pnpm"
path=("$PNPM_HOME" $path)

export PATH
{{ else if eq .chezmoi.hostname "mugen" -}}
# ── mugen ────────────────────────────────────────────────────────────────────
# Nothing machine-specific: mugen's setup *is* the shared baseline.
{{ end -}}
