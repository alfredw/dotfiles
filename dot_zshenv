export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

export ZINIT_HOME="$XDG_DATA_HOME/zinit/zinit.git"

typeset -U path PATH
path=("$HOME/.local/bin" "/opt/homebrew/bin" $path)

# Let gcloud reuse the system Python's site-packages (faster startup).
# https://cloud.google.com/sdk/docs/configuration#cloudsdk_python_sitepackages
export CLOUDSDK_PYTHON_SITEPACKAGES=1

# Pin gcloud's interpreter: without this it takes the first `python3` on PATH,
# which falls back to the Command Line Tools' Python 3.9 (too old for gcloud).
# The opt/ path survives patch upgrades of python@3.14.
export CLOUDSDK_PYTHON=/opt/homebrew/opt/python@3.14/bin/python3.14
